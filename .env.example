# RHINO-CAR Environment Configuration

# === LLM CONFIGURATION ===

# Google Gemini API Key (for enhanced emergency responses)
# 🔑 Get FREE key: https://ai.google.dev/ (Google AI Studio)
# 📋 Instructions: 
#   1. Go to https://ai.google.dev/
#   2. Sign in with Google account  
#   3. Click "Get API Key" → "Create API Key"
#   4. Copy the key (starts with "AIza...")
GEMINI_API_KEY=your_gemini_api_key_here

# === MAPPING API OPTIONS (Choose one or multiple) ===

# 🥇 RECOMMENDED: Mapbox API (Best for vehicle navigation)
# ✅ 100,000 FREE requests/month - Perfect for RHINO-CAR!
# ✅ Real-time traffic data ✅ High reliability ✅ No credit card needed
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# Google Maps API Key (navigation features)  
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenStreetMap/OpenRouteService (FREE but limited)
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key

# HERE Maps API (Enterprise grade)
HERE_API_KEY=your_here_api_key

# MapQuest API (Free tier: 15,000/month)
MAPQUEST_API_KEY=your_mapquest_api_key

# Bing Maps API (Microsoft)
BING_MAPS_API_KEY=your_bing_maps_api_key

# Preferred mapping service (mapbox|google|openroute|here|mapquest|bing)
MAP_SERVICE_PROVIDER=mapbox

# Google Cloud Speech API (optional - for better STT)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token  
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Email Configuration
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Serial Port Configuration
SERIAL_PORT=COM14
SERIAL_BAUDRATE=115200

# Video Stream Configuration  
VIDEO_URL=http://192.168.82.137:8080/video
