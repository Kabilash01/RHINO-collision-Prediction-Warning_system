# RHINO-CAR Environment Configuration

# Google Gemini API Key (for enhanced LLM responses)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key (for navigation features)  
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Cloud Speech API (optional - for better STT)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token  
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Email Configuration
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Serial Port Configuration
SERIAL_PORT=COM14
SERIAL_BAUDRATE=115200

# Video Stream Configuration  
VIDEO_URL=http://192.168.82.137:8080/video
